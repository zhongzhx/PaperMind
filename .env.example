# LLM API configuration
# Supports any OpenAI-compatible API provider.
# Set to your LLM provider's base URL and API key.
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# If no LLM_API_KEY is set, the engine falls back to MockLLM
# for local testing without external API calls.
